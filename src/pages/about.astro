---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Mail, Phone, MapPin } from "@lucide/astro";

const pageTitle="About Me | Devang Suthar";
const pageDescription="Get to know Devang Suthar, a Full Stack Developer. Explore my professional journey, technical skills, experience, and passion for web development.";
const noIndex = true;

const myPersonalInfo = {
	firstName: "Devang",
	lastName: "Suthar",
	age: 27,
	profession: "Full Stack Developer",
	description:
		"Hello, I am a passionate Full Stack Developer with expertise in building web applications using modern technologies. I enjoy solving complex problems and creating efficient solutions.",
	skills: [
		"JavaScript",
		"TypeScript",
		"React",
		"Node.js",
		"Astro",
		"Tailwind CSS",
	],
	contact: {
		email: "devangsuthar24@gmail.com",
		phone: "+91 762-186-3619",
		address: "Ahmedabad, Gujarat, India",
	},
	isGraduated: true,
	isEmployed: false,
	totalExperience: 5,
};

const { textColor = "brown", fontWeight = "700" } = Astro.props;
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} noIndex={noIndex}>
	<div class="info">
		<h2>Personal Information:</h2>
		<h3>My Name is {myPersonalInfo.firstName} {myPersonalInfo.lastName}</h3>
		<p>
			I am {myPersonalInfo.age} years old and currently working as a {
				myPersonalInfo.profession
			}.
		</p>

		<div>
			<h2 class="text-xl font-bold mb-2 mt-5">Skills:</h2>
			<ul class="list-disc pl-4">
				{myPersonalInfo.skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</div>

		<div>
			<h2 class="text-xl font-bold mb-2 mt-5">Contact Information:</h2>
			<div class="block space-y-4 mt-5">
				<h5 class="flex gap-3">
					<Mail />
					<a
						class="text-md font-medium hover:text-blue-700"
						href=`mailto:${myPersonalInfo.contact.email}`
						>{myPersonalInfo.contact.email}</a
					>
				</h5>
				<h5 class="flex gap-3">
					<Phone />
					<a
						href=`tel:${myPersonalInfo.contact.phone}`
						class="text-md font-medium hover:text-blue-700"
					>
						{myPersonalInfo.contact.phone}
					</a>
				</h5>
				<h5 class="flex gap-3">
					<MapPin />
					<p class="text-md font-medium transition-all">
						{myPersonalInfo.contact.address}
					</p>
				</h5>
			</div>
		</div>

		<div>
			<h2 class="text-xl font-bold mb-2 mt-5">Education:</h2>
			<p>
				{
					myPersonalInfo.isGraduated
						? "I have graduated from GTU."
						: "I am currently pursuing my education."
				}
			</p>
			<p>
				{
					myPersonalInfo.totalExperience === 0
						? "I am a fresher with no prior work experience."
						: "I have " +
							myPersonalInfo.totalExperience +
							`${myPersonalInfo.totalExperience === 1 ? " year" : " years"} of experience in the industry.`
				}
			</p>
		</div>
	</div>
</BaseLayout>

<style define:vars={{ textColor, fontWeight }}>
	h1 {
		font-size: 3rem;
	}
	ul li {
		color: var(--textColor);
		font-weight: var(--fontWeight);
	}
</style>

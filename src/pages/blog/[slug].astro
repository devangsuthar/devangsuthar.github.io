---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
console.log("post", post);
---

<BaseLayout pageTitle={`${post.data.title} | Dev Tech`}>
    <main class="mx-auto w-full max-w-3xl px-4 py-12">
        <a
            href="/blog"
            class="text-sm text-blue-700 hover:underline dark:text-blue-400"
            >← Back to all posts</a
        >
        <h1 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white">
            {post.data.title}
        </h1>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
            By {post.data.author} ·
            <time datetime={post.data.pubDate.toISOString()}>
                {
                    post.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </time>
        </p>
        <article class="mt-8 space-y-4 text-gray-800 dark:text-gray-200">
            <Content />
        </article>
    </main>
</BaseLayout>

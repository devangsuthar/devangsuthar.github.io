---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
---

<BaseLayout pageTitle="Developer Blog | Devang Suthar - Web Development & Astro"
 pageDescription="Follow Devang Suthar's development journey through articles about Astro, web development, programming, and modern technologies.">
    <main class="px-4 py-12 lg:px-2">
        <div class="mx-auto w-full max-w-screen-xl">
            <header class="mb-10">
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
                    Blog Archive
                </h1>
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    {posts.length}
                    {posts.length === 1 ? " post" : " posts"} on code, sports and
                    giving back.
                </p>
            </header>

            {
                posts.length === 0 ? (
                    <p class="text-gray-600 dark:text-gray-400">
                        No posts yet. Check back soon!
                    </p>
                ) : (
                    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                        {posts.map((post) => (
                            <li class="flex flex-col rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                    class="text-sm text-gray-500 dark:text-gray-400"
                                >
                                    {formatDate(post.data.pubDate)}
                                </time>
                                <h2 class="mt-2 text-xl font-semibold text-gray-900 dark:text-white">
                                    <a
                                        href={`/blog/${post.id}`}
                                        class="hover:text-blue-700 dark:hover:text-blue-400"
                                    >
                                        {post.data.title}
                                    </a>
                                </h2>
                                <p class="mt-3 flex-1 text-gray-600 dark:text-gray-300">
                                    {post.data.description}
                                </p>
                                {post.data.tags.length > 0 && (
                                    <ul class="mt-4 flex flex-wrap gap-2">
                                        {post.data.tags.map((tag) => (
                                            <li class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                                                #{tag}
                                            </li>
                                        ))}
                                    </ul>
                                )}
                                <a
                                    href={`/blog/${post.id}`}
                                    class="mt-5 text-sm font-medium text-blue-700 hover:underline dark:text-blue-400"
                                >
                                    Read more →
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </main>
</BaseLayout>
